# Where the services are running. Every spec skips (with a reason) when its service is unreachable.
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000
DEID_URL=http://localhost:8002

# Login used for authenticated specs. Defaults are the demo admin seeded by
# backend/scripts/setup_demo_data.py and shown on the login page.
E2E_EMAIL=demo@clinicalmind.com
E2E_PASSWORD=Password123!

# Payments: you normally do NOT set keys here. Connect the demo clinic's own Razorpay account ONCE
# (Settings → Payments in the app, or `backend/scripts/connect_demo_razorpay.py rzp_test_xxx <secret>`);
# the keys are then stored in the demo DB and the payment specs pick them up automatically — the suite
# only reads the public key id, never the secret. These two are OPTIONAL and only drive the extra
# "type/validate a fresh pair" write test. Test-mode keys only; never put live keys here.
E2E_RAZORPAY_KEY_ID=
E2E_RAZORPAY_KEY_SECRET=

# Where the backend writes emails instead of sending them (its EMAIL_OUTBOX_DIR, dev/test only). The
# portal-invite spec reads the invite link from here; it fails with a hint when no email arrives there.
E2E_EMAIL_OUTBOX=../backend/.email-outbox
