# Where the services are running. Every spec skips (with a reason) when its service is unreachable.
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000
DEID_URL=http://localhost:8002

# Login used for authenticated specs. Defaults are the demo admin seeded by
# backend/scripts/setup_demo_data.py and shown on the login page.
E2E_EMAIL=demo@clinicalmind.com
E2E_PASSWORD=Password123!

# Razorpay TEST-mode keys (dashboard → Account & Settings → API Keys). The payment specs connect them to
# the demo clinic through Settings → Payments and skip when they are unset. Never put live keys here.
E2E_RAZORPAY_KEY_ID=
E2E_RAZORPAY_KEY_SECRET=
